[
    // General
    {
        "bindings": {
            "shift shift": "file_finder::Toggle",
            "alt alt": "project_symbols::Toggle",
            "alt-b": "git::Branch",
            "alt-t": "terminal_panel::ToggleFocus",
            "alt-shift-t": "workspace::ToggleBottomDock",
            "alt-e": "project_panel::ToggleFocus",
            "alt-shift-e": "workspace::ToggleLeftDock",
            "alt-g": "git_panel::ToggleFocus",
            "alt-shift-g": "workspace::ToggleLeftDock",
            "alt-a": "agent::ToggleFocus",
            "alt-shift-a": "workspace::ToggleRightDock",
        },
    },
    {
        "context": "Editor && vim_mode == normal",
        "bindings": {
            "space g e": "editor::GoToDiagnostic",
            "space g p": "editor::GoToPreviousDiagnostic",
        },
    },
    // Linux
    {
        "bindings": {
            "ctrl ctrl": "text_finder::Toggle",
        },
    },
    {
        "context": "Editor && os != macos",
        "bindings": {
            "ctrl-space": "editor::ShowCompletions",
            "ctrl-p": "editor::ShowSignatureHelp",
            "ctrl-d": "editor::GoToDefinition",
            "ctrl-r": "editor::Rename",
            "ctrl-f": "editor::FindAllReferences",
            "ctrl-h": "pane::GoBack",
            "ctrl-l": "pane::GoForward",
            "ctrl-shift-h": "pane::ActivatePreviousItem",
            "ctrl-shift-l": "pane::ActivateNextItem",
            "ctrl-o": "outline::Toggle",
            "ctrl-w": "pane::CloseActiveItem"
        },
    },
    {
        "context": "Terminal && os != macos",
        "bindings": {
            "ctrl-n": "workspace::NewTerminal",
            "ctrl-h": "pane::GoBack",
            "ctrl-l": "pane::GoForward",
            "ctrl-shift-h": "pane::ActivatePreviousItem",
            "ctrl-shift-l": "pane::ActivateNextItem",
        },
    },
    {
        "context": "ProjectPanel && os != macos",
        "bindings": {
            "ctrl-n": "project_panel::NewFile",
            "ctrl-f": "project_panel::NewDirectory",
            "ctrl-d": "project_panel::Delete",
            "ctrl-r": "project_panel::Rename",
        },
    },
    // MacOS
    {
        "bindings": {
            "cmd cmd": "text_finder::Toggle",
        },
    },
    {
        "context": "Editor && os == macos",
        "bindings": {
            "cmd-space": "editor::ShowCompletions",
            "cmd-p": "editor::ShowSignatureHelp",
            "cmd-d": "editor::GoToDefinition",
            "cmd-f": "editor::FindAllReferences",
            "cmd-r": "editor::Rename",
            "cmd-h": "pane::GoBack",
            "cmd-l": "pane::GoForward",
            "cmd-shift-h": "pane::ActivatePreviousItem",
            "cmd-shift-l": "pane::ActivateNextItem",
            "cmd-o": "outline::Toggle",
            "cmd-w": "pane::CloseActiveItem"
        },
    },
    {
        "context": "Terminal && os == macos",
        "bindings": {
            "cmd-n": "workspace::NewTerminal",
            "cmd-h": "pane::GoBack",
            "cmd-l": "pane::GoForward",
            "cmd-shift-h": "pane::ActivatePreviousItem",
            "cmd-shift-l": "pane::ActivateNextItem",
        },
    },
    {
        "context": "ProjectPanel && os == macos",
        "bindings": {
            "cmd-n": "project_panel::NewFile",
            "cmd-f": "project_panel::NewDirectory",
            "cmd-d": "project_panel::Delete",
            "cmd-r": "project_panel::Rename",
        },
    },
]
