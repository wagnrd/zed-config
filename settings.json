// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
    // Zed
    "text_rendering_mode": "platform_default",
    "ui_font_size": 17.0,
    "diff_view_style": "unified",
    "agent_buffer_font_size": 16.0,
    "cli_default_open_behavior": "new_window",
    "terminal": {
        "cursor_shape": "bar",
    },
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "group_by": "none",
        "dock": "left",
        "file_icons": true,
        "tree_view": true,
    },
    "language_models": {
        "lmstudio": {
            "api_url": "http://localhost:1234/api/v0",
        },
    },
    "restore_on_startup": "last_workspace",
    "lsp_results_location": "picker",
    "preview_tabs": {
        "enabled": true,
    },

    // AI
    "edit_predictions": {
        "provider": "zed",
        "open_ai_compatible_api": {
            "api_url": "http://localhost:1234/v1/completions",
            "model": "sweep-next-edit-1.5B",
            "prompt_format": "sweep",
            "max_output_tokens": 512
        }
    },
    "agent": {
        "default_model": {
            "provider": "lmstudio",
            "model": "google/gemma-4-26b-a4b-qat",
            "enable_thinking": false,
        },
        "sidebar_side": "right",
        "dock": "right",
        "tool_permissions": {
            "tools": {
                "create_directory": {
                    "default": "allow",
                },
            },
        },
        "default_profile": "ask",
    },
    "context_servers": {
        "svelte-mcp": {
            "enabled": true,
            "remote": false,
            "settings": {},
        },
        "mcp-server-grafana": {
            "enabled": true,
            "remote": false,
            "settings": {},
        },
    },
    "agent_servers": {
        "codex-acp": {
            "default_config_options": {
                "collaboration_mode": "default",
                "fast-mode": false,
                "model": "gpt-5.6-terra",
                "reasoning_effort": "high",
                "mode": "agent",
            },
            "favorite_config_option_values": {
                "reasoning_effort": ["high"],
            },
            "type": "registry",
        },
        "claude-acp": {
            "default_config_options": {
                "mode": "auto",
                "effort": "xhigh",
                "model": "opus[1m]",
            },
            "type": "registry",
        },
        "opencode": {
            "default_config_options": {
                "effort": "max",
                "model": "opencode/deepseek-v4-flash-free",
                "mode": "build"
            },
            "type": "registry",
        },
        "cursor": {
            "default_config_options": {
                "fast": "false",
                "thinking": "true",
                "effort": "xhigh",
                "context": "300k",
                "model": "claude-fable-5-1",
                "mode": "agent",
            },
            "type": "registry",
        },
    },

    // Editor
    "vim_mode": true,
    "vim": {
        "use_system_clipboard": "always",
    },
    "relative_line_numbers": "enabled",
    "remove_trailing_whitespace_on_save": true,
    "base_keymap": "JetBrains",
    "preferred_line_length": 120,
    "wrap_guides": [120],
    "theme": {
        "light": "Ayu Light Italic",
        "dark": "Ayu Mirage",
        "mode": "light",
    },
    "icon_theme": {
        "mode": "system",
        "light": "Colored Zed Icons Theme Light",
        "dark": "Colored Zed Icons Theme Dark",
    },
    "buffer_line_height": {
        "custom": 1.3,
    },
    "tab_size": 4,
    "buffer_font_size": 18,
    "buffer_font_family": "Ubuntu Mono",
    "autosave": "on_focus_change",
    "inlay_hints": {
        "toggle_on_modifiers_press": {
            "control": true,
            "shift": true,
        },
    },
    "snippet_sort_order": "top",
    "current_line_highlight": "gutter",
    "diagnostics": {
        "include_warnings": true,
        "inline": {
            "enabled": true,
            "update_debounce_ms": 150,
            "padding": 4,
            "min_column": 0,
            "max_severity": null,
        },
    },

    // Languages and LSPs
    "lsp": {
        "typescript-ls": {
            "settings": {
                "typescript": {
                    "tsserver": { "maxTsServerMemory": 16184 },
                    "preferences": {
                        "importModuleSpecifier": "non-relative",
                    },
                    "inlayHints": {
                        "parameterNames": {
                            "enabled": false,
                            "suppressWhenArgumentMatchesName": true,
                        },
                        "parameterTypes": { "enabled": true },
                        "variableTypes": {
                            "enabled": false,
                            "suppressWhenTypeMatchesName": true,
                        },
                        "propertyDeclarationTypes": { "enabled": true },
                        "functionLikeReturnTypes": { "enabled": true },
                        "enumMemberValues": { "enabled": true },
                    },
                },
                "javascript": { "tsserver": { "maxTsServerMemory": 16184 } },
            },
        },
        "rust-analyzer": {
            "initialization_options": {
                "check": {
                    "command": "clippy",
                },
            },
        },
    },
}
